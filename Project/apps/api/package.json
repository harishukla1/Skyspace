{
  "name": "@skyspace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "memdb": "tsx src/scripts/memdb.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "openapi": "tsx src/scripts/write-openapi.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@skyspace/shared": "0.1.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.7",
    "multer": "2.0.2",
    "nodemailer": "^7.0.10",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.1.4",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "vitest": "3.2.7"
  }
}

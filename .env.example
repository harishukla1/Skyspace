# ---------------------------------------------------------------------------
# Sky Space Realty — environment template. Copy to `.env` and fill in values.
# NEVER commit real secrets. In production use your host's secret manager.
# ---------------------------------------------------------------------------

# ----- Backend (apps/api) -----
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins (CORS + links in emails)
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/skyspace
MONGODB_MAX_POOL_SIZE=20

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string-32
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Set to the shared parent domain in production, e.g. .skyspacerealty.in (web on www., API on api.)
COOKIE_DOMAIN=
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=

# Email: console (logs only, nothing is sent) | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Sky Space Realty <no-reply@example.com>

# SMS/OTP: console only is implemented (see docs/deployment.md)
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=

# Images: local (dev, stored in apps/api/uploads) | s3 (any S3-compatible service)
STORAGE_DRIVER=local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Public base URL for objects (CDN or bucket URL)
OBJECT_STORAGE_PUBLIC_URL=

# Anti-bot for public forms: none | turnstile | recaptcha
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET=

RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# ----- Frontend (apps/web) — NEXT_PUBLIC_* values are visible to browsers -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-side URL the Next.js server uses to reach the API (can be an internal address)
API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# none | google | mapbox
NEXT_PUBLIC_MAPS_PROVIDER=none
# Browser key: must be restricted by HTTP referrer in the provider console
NEXT_PUBLIC_MAPS_API_KEY=
